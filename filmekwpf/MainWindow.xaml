<Window x:Class="filmekwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:filmekwpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="Filmek betöltése" Click="filmbetolt" Margin="10"/>
            <Button Content="Leghosszabb film?" Click="leghosszabb" Margin="10"/>
            <Button Content="Átlag értékelés" Click="atlagertekeles" Margin="10"/>
            <Button Content="Csak sci-fi" Click="csakscifi" Margin="10"/>
            <Button Content="Csak címek" Click="csakcimek" Margin="10"/>
            <Button Content="Rendezés cím szerint" Click="rendezes" Margin="10"/>
            <ProgressBar Height="20" Margin="10" x:Name="pgHossz"/>
        </StackPanel>
        <DataGrid Grid.Column="1" x:Name="dgFilmek" SelectionChanged="hosszKiir"/>
    </Grid>
</Window>
